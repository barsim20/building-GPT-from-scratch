lexity\n","    val_pp, val_pp_char = perplexity_temp(\n","        model_k,\n","        val_sequences,\n","        val_char_count\n","    )\n","\n","    # test perplexity\n","    test_pp, test_pp_char = perplexity_temp(\n","        model_k,\n","        test_sequences,\n","        test_char_count\n","    )\n","\n","    # saving results\n","    experiment1_results.append({\n","        \"k\": k,\n","        \"Validation PP\": val_pp,\n","        \"Validation PP char\": val_pp_char,\n","        \"Test PP\": test_pp,\n","        \"Test PP char\": test_pp_char\n","    })\n","\n","\n","# creating result table\n","experiment1_table = pd.DataFrame(experiment1_results)\n","\n","display(experiment1_table.round(3))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":143},"id":"3wkwmYLEd7_Q","executionInfo":{"status":"ok","timestamp":1790080486681,"user_tz":-120,"elapsed":86550,"user":{"displayName":"Jonas Hötker","userId":"13128500584511511168"}},"outputId":"abea5602-4a02-4b2d-947b-472cdf1e4f5c"},"execution_count":97,"outputs":[{"output_type":"display_data","data":{"text/plain":["      k  Validation PP  Validation PP char  Test PP  Test PP char\n","0   250         43.272               6.499   50.450         7.295\n","1  1000        135.971               6.316  168.791         7.439\n","2  4000        494.859               6.272  590.517         7.656"],"text/html":["\n","  <div id=\"df-c5276bfa-b137-4e38-bf4e-c3a84dbdc6a1\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>k</th>\n","      <th>Validation PP</th>\n","      <th>Validation PP char</th>\n","      